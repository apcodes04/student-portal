{
  "functions": {
    "api/index.py": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    {
      "source": "/applications(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/applications",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
